# ============================================================
# Agentic AI Task Planner — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================================

# --- Required ---------------------------------------------------
# Google Gemini API key — obtain from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# --- Optional: Web Search --------------------------------------
# SerpAPI key — obtain from https://serpapi.com/
# If not provided, web search tool returns simulated results.
SERPAPI_API_KEY=your_serpapi_key_here

# --- Safety Limits ----------------------------------------------
# Maximum seconds a code execution subprocess may run
MAX_CODE_EXEC_TIMEOUT=10

# Maximum steps the agent may execute per run
MAX_STEPS_PER_RUN=10

# Maximum tokens the agent may consume per run
MAX_TOKENS_PER_RUN=50000

# Comma-separated directories the file_reader tool may access
ALLOWED_FILE_READ_DIRS=./data,./

# Email drafting — always draft-only, never send
EMAIL_DRAFT_ONLY=true

# --- Gemini Model -----------------------------------------------
# gemini-1.5-flash (fast, generous free tier) or gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash
